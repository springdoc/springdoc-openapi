<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springdoc</groupId>
		<artifactId>springdoc-openapi</artifactId>
		<version>3.1.2-SNAPSHOT</version>
	</parent>
	<artifactId>springdoc-openapi-starter-common-mcp</artifactId>
	<name>${project.artifactId}</name>
	<properties>
		<skip.npm>false</skip.npm>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-mcp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>org.springdoc.openapi.ai.common
							</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					<filesets>
						<fileset>
							<directory>src/main/frontend/node_modules</directory>
						</fileset>
						<!-- Build output that older revisions of this module wrote into the source
						     tree. Nothing generates it any more, but a stale copy left in a working
						     copy should not survive a clean. -->
						<fileset>
							<directory>src/main/resources/mcp-ui</directory>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<!-- The dashboard assets are written by the frontend build straight into
			     ${project.build.outputDirectory}/mcp-ui, which mvn clean removes. Exclude any
			     copy sitting in the source tree, so a leftover from an earlier build (or from a
			     standalone npm run build) can never be packaged in place of freshly built
			     assets. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>default-resources</id>
						<configuration>
							<excludes>
								<exclude>mcp-ui/**</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<configuration>
					<workingDirectory>src/main/frontend</workingDirectory>
					<installDirectory>target/frontend</installDirectory>
					<skip>${skip.npm}</skip>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>${node.version}</nodeVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm-install</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>install</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm-build</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
							<environmentVariables>
								<MCP_UI_OUT_DIR>${project.build.outputDirectory}/mcp-ui</MCP_UI_OUT_DIR>
							</environmentVariables>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- The dashboard assets are generated by the frontend plugin above and are not
			     tracked by git, so a build that skips the frontend step would silently package
			     a jar without the UI. Fail such a build instead of shipping it. This runs from
			     the project itself, so it also covers release:perform, which builds in its own
			     target/checkout where a workflow-level path check would not apply. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>require-mcp-dashboard-assets</id>
						<phase>process-classes</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<skip>${skip.npm}</skip>
							<rules>
								<requireFilesExist>
									<message>The MCP dashboard assets are missing from ${project.build.outputDirectory}/mcp-ui, so the packaged jar would ship without the UI. They are generated by frontend-maven-plugin; build without -Dskip.npm=true.</message>
									<files>
										<file>${project.build.outputDirectory}/mcp-ui/index.html</file>
									</files>
								</requireFilesExist>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
